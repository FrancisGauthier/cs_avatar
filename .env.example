# Local-only PostgreSQL credentials; use unique secrets outside development.
POSTGRES_PASSWORD=local-dev-only
DATABASE_URL=postgresql+asyncpg://cs_avatar:local-dev-only@127.0.0.1:5432/cs_avatar

PUBLIC_APP_ORIGIN=http://127.0.0.1:5173
STEAM_OPENID_REALM=http://127.0.0.1:5173/
STEAM_OPENID_RETURN_TO=http://127.0.0.1:5173/api/v1/auth/steam/callback

# Replace both placeholders before starting the backend.
SESSION_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
STEAM_WEB_API_KEY=replace-with-a-server-only-steam-web-api-key
